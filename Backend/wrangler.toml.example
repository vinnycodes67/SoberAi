name = "sober-guardian"
main = "worker.js"
compatibility_date = "2026-08-04"

[[durable_objects.bindings]]
name = "GUARDIAN_RELATIONSHIPS"
class_name = "GuardianRelationship"

[[migrations]]
tag = "guardian-v1"
new_sqlite_classes = ["GuardianRelationship"]

[vars]
# Safe deployment default. For local founder review only, put
# `GUARDIAN_FOUNDER_MODE=true` in an ignored `.dev.vars` file.
GUARDIAN_FOUNDER_MODE = "false"
