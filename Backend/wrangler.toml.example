name = "sober-parent-alerts"
main = "worker.js"
compatibility_date = "2026-08-04"

[[durable_objects.bindings]]
name = "ALERT_COORDINATOR"
class_name = "AlertCoordinator"

[exports.AlertCoordinator]
type = "durable-object"
storage = "sqlite"

# Configure secrets with `wrangler secret put` rather than committing them:
# ALERT_SHARED_TOKEN
# TWILIO_ACCOUNT_SID
# TWILIO_AUTH_TOKEN
# TWILIO_FROM_NUMBER
# ALERT_ALLOWED_RECIPIENTS (comma-separated E.164 numbers for founder testing)

# Optional non-secret tuning values. Defaults are 24-hour event deduplication
# and at most 3 new alerts to one recipient in 10 minutes:
# ALERT_DEDUP_WINDOW_SECONDS = "86400"
# ALERT_RATE_WINDOW_SECONDS = "600"
# ALERT_MAX_PER_RATE_WINDOW = "3"
